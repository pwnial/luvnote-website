{
  "name": "luvnote-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "build": "vite build && node scripts/generate-route-html.mjs",
    "dev": "vite",
